{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclipse-vector.local/schemas/enemy-archetype.schema.json",
  "title": "Eclipse Vector EnemyArchetypeDefinition",
  "type": "object",
  "required": ["id", "version", "displayName", "factionId", "radius", "stats", "behavior", "tags"],
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "version": { "$ref": "#/$defs/semver" },
    "displayName": { "type": "string", "minLength": 1 },
    "factionId": { "$ref": "#/$defs/stableId" },
    "radius": { "type": "number", "exclusiveMinimum": 0 },
    "stats": {
      "type": "object",
      "required": ["hull", "shield", "maxHeat"],
      "properties": {
        "hull": { "type": "number", "exclusiveMinimum": 0 },
        "shield": { "type": "number", "minimum": 0 },
        "maxHeat": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "required": [
        "moveSpeed",
        "preferredRange",
        "fireRange",
        "fireCooldownMs",
        "projectileSpeed",
        "projectileLifetimeMs",
        "projectileDamage",
        "projectileDamageType"
      ],
      "properties": {
        "moveSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "preferredRange": { "type": "number", "exclusiveMinimum": 0 },
        "fireRange": { "type": "number", "exclusiveMinimum": 0 },
        "fireCooldownMs": { "type": "number", "exclusiveMinimum": 0 },
        "projectileSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "projectileLifetimeMs": { "type": "number", "exclusiveMinimum": 0 },
        "projectileDamage": { "type": "number", "exclusiveMinimum": 0 },
        "projectileDamageType": {
          "enum": ["kinetic", "energy", "plasma", "ion", "veil"]
        }
      },
      "additionalProperties": false
    },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/stableId" } }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
